# Copy to .env and fill in. Never commit the real .env.
PORT=8080

# How long a fetched profile stays cached (Go duration: 30m, 6h, 24h).
# Defaults to 6h. Kept deliberately long because a LinkedIn session survives
# only a few requests, so a cached profile outlives the cookie that fetched it.
CACHE_TTL=6h

# LinkedIn session cookies, copied from a logged-in browser session.
# See the README section "Getting your LinkedIn cookies".
#
# li_at is the authentication cookie.
LINKEDIN_LI_AT=

# JSESSIONID includes the surrounding quotes, e.g. "ajax:1234567890123456789".
# Its value is also sent back as the csrf-token header, so it must be copied
# exactly, quotes included.
LINKEDIN_JSESSIONID=
